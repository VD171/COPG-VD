# vdlu-verify <manifest.json> <keyring_dir> - verify a VDLU manifest signature on-device.
# rc 0 = signature valid against the keyring pubkey whose id matches key_id; rc != 0 = reject.
# SLIM: toybox sha256sum/base64 + the embedded ed25519-mini,
# NO openssl. The keyring pubkey is RAW 32 bytes. Same CLI/rc as the openssl version it replaces,
# so the engine's verify_manifest is unchanged. INTERFACES.md §6.
set -eu

if [ $# -ne 2 ]; then
	echo "usage: vdlu-verify <manifest.json> <keyring_dir>" >&2
	exit 2
fi

manifest=$1
keyring=$2

[ -f "$manifest" ] || { echo "vdlu-verify: no such manifest: $manifest" >&2; exit 2; }
[ -d "$keyring" ] || { echo "vdlu-verify: no such keyring dir: $keyring" >&2; exit 2; }

here=$(dirname "$0")

# locate the ed25519-mini verifier: pruned single (customize keeps the device ABI), else per-ABI.
mini="$here/ed25519-mini"
if [ ! -x "$mini" ]; then
	abi=$(getprop ro.product.cpu.abi 2>/dev/null)
	case "$abi" in
		'') case "$(uname -m 2>/dev/null)" in
				aarch64) abi=arm64-v8a ;;
				armv7l|armv7*|armv8l) abi=armeabi-v7a ;;
				x86_64) abi=x86_64 ;;
				i686|i386) abi=x86 ;;
			esac ;;
	esac
	mini="$here/verify/$abi/ed25519-mini"
fi
[ -x "$mini" ] || { echo "vdlu-verify: ed25519-mini not found/executable (near $here)" >&2; exit 2; }

# --- shared canonicalization (identical in producer/vdlu-sign) -------------------
# Canonical form = the manifest text with the "sig" field removed. The manifest is stored compact +
# sorted-keys (vdlu-pack), so "sig" is always ,"sig":"...". We hash the sha256 hex of that form; that
# 64-char ASCII hex string is the exact message the signature covers (ed25519 hashes it internally).
vdlu_canon_sha256() {
	_c=$1
	case "$_c" in *'"sig":"'*) : ;; *) echo "vdlu: manifest has no sig field" >&2; return 1;; esac
	_pre=${_c%%\"sig\":\"*}
	_rest=${_c#*\"sig\":\"}
	_tail=${_rest#*\",}
	printf '%s%s' "$_pre" "$_tail" | sha256sum | cut -d' ' -f1
}
# --------------------------------------------------------------------------------

field() {
	# field <content> <key> -> value of a flat string field (no " in value)
	_c=$1
	case "$_c" in *"\"$2\":\""*) : ;; *) return 1;; esac
	_r=${_c#*\"$2\":\"}
	printf '%s' "${_r%%\"*}"
}

# Cap the manifest before reading it (anti-OOM): a MITM'd feed could serve a huge body before any check.
# Same 2 MiB ceiling the engine's dl_manifest enforces (vdlu-verify ships no shared const, so it is inline).
MAX_MANIFEST_BYTES=2097152
msz=$(wc -c <"$manifest" 2>/dev/null || echo 0)
[ "${msz:-0}" -le "$MAX_MANIFEST_BYTES" ] || { echo "vdlu-verify: manifest too large ($msz)" >&2; exit 1; }

c=$(cat "$manifest")

key_id=$(field "$c" key_id) || { echo "vdlu-verify: no key_id in manifest" >&2; exit 1; }
sig=$(field "$c" sig) || { echo "vdlu-verify: no sig in manifest" >&2; exit 1; }
[ -n "$key_id" ] || { echo "vdlu-verify: empty key_id" >&2; exit 1; }
[ -n "$sig" ] || { echo "vdlu-verify: empty sig (unsigned manifest)" >&2; exit 1; }

case "$key_id" in */*|..|.|*'"'*) echo "vdlu-verify: unsafe key_id: $key_id" >&2; exit 1;; esac

# VDLU#1 trust-root allowlist (mirror of the engine's verify_manifest): the key_id must be an ACCEPTED
# module-update key BEFORE a pubkey is selected, so a lower-trust key that merely sits in the keyring
# (e.g. a fingerprint-feed key) can never sign a module/tools update. Allowlist = VDLU_KEYID_ALLOW
# (comma/space/newline separated, passed by the engine from config `key_id`); when unset, default-safe =
# the single *.pub in the keyring, and a MULTI-key keyring with no explicit allowlist is rejected.
allow=${VDLU_KEYID_ALLOW:-}
if [ -z "$allow" ]; then
	n=0; only=""
	for f in "$keyring"/*.pub; do
		[ -f "$f" ] || continue
		n=$((n+1)); only=${f##*/}; only=${only%.pub}
	done
	[ "$n" -ne 0 ] || { echo "vdlu-verify: no *.pub in keyring $keyring" >&2; exit 1; }
	[ "$n" -le 1 ] || { echo "vdlu-verify: multiple keys in keyring; set VDLU_KEYID_ALLOW (config key_id)" >&2; exit 1; }
	allow="$only"
fi
allow=$(printf '%s' "$allow" | tr ',\r\n' '   ')   # normalize to space-separated
_ok=0
for k in $allow; do [ "$k" = "$key_id" ] && _ok=1; done
[ "$_ok" = 1 ] || { echo "vdlu-verify: key_id '$key_id' not in allowed module-update key set" >&2; exit 1; }

pub="$keyring/$key_id.pub"
[ -f "$pub" ] || { echo "vdlu-verify: no pubkey for key_id=$key_id in $keyring" >&2; exit 1; }
pubsz=$(wc -c <"$pub" 2>/dev/null || echo 0)
[ "$pubsz" -eq 32 ] || { echo "vdlu-verify: keyring pubkey not raw 32 bytes (got $pubsz) for key_id=$key_id" >&2; exit 1; }

hex=$(vdlu_canon_sha256 "$c")

tmpd=$(mktemp -d "${TMPDIR:-/data/local/tmp}/vdlu-verify.XXXXXX" 2>/dev/null || mktemp -d)
trap 'rm -rf "$tmpd"' EXIT INT TERM
printf '%s' "$hex" > "$tmpd/msg"
printf '%s' "$sig" | base64 -d > "$tmpd/sig.bin" 2>/dev/null || { echo "vdlu-verify: malformed base64 signature" >&2; exit 1; }
sigsz=$(wc -c <"$tmpd/sig.bin" 2>/dev/null || echo 0)
[ "$sigsz" -eq 64 ] || { echo "vdlu-verify: signature not 64 bytes (got $sigsz)" >&2; exit 1; }

if "$mini" "$pub" "$tmpd/msg" "$tmpd/sig.bin" >/dev/null 2>&1; then
	echo "vdlu-verify: OK key_id=$key_id canon_sha256=$hex" >&2
	exit 0
fi
echo "vdlu-verify: SIGNATURE REJECTED key_id=$key_id" >&2
exit 1
